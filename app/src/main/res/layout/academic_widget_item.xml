<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="7dp">

    <TextView
        android:id="@+id/widget_item_color"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:background="#2563EB" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_subject_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#93C5FD"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_item_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_item_deadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prazo hoje"
            android:textColor="#FCA5A5"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
